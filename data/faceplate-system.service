[Unit]
Description=Faceplate local read-only status collector
Before=faceplate.service

[Service]
Type=oneshot
User=faceplate-status
Group=faceplate-status
RuntimeDirectory=faceplate-system
RuntimeDirectoryMode=0750
ExecStart=/usr/bin/faceplate-collector
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_NETLINK AF_UNIX
SystemCallArchitectures=native
ReadWritePaths=/run/faceplate-system

